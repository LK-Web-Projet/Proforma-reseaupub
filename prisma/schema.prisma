generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
        

// --- MODELS ---

// --- ENUMS ---
enum StatusFacture {
  Brouillon
  Envoyer
  Valider
  Annuler
  Archiver
  Payer // Changed from Activer to Payer
}

enum UniteDuree {
  jour
  heure
  mois
}
enum Devise {
  XOF   // Franc CFA
  EUR   // Euro
  USD   // Dollar
}
model Client {
  id        String    @id @default(uuid())
  nom       String    @unique
  email     String?
  telephone String?
  adresse   String?
  factures  Invoice[]
}

model Produit {
  id           String @id @default(uuid())
  nom          String @unique
  prixUnitaire Decimal
  produitsFacture InvoiceProduit[]
}


model Invoice {
  id                      String           @id @default(uuid())
  numero                  String           @unique
  dateCreation            DateTime         @default(now())
  objet                   String
  clientId                String
  client                  Client           @relation(fields: [clientId], references: [id])
  totalHT                 Decimal
  tva                     Decimal
  totalTTC                Decimal
  statut                  StatusFacture @default(Brouillon)
  produits                InvoiceProduit[]
  historiqueModifications Json?
  societeNom              String
  societeIFU              String
  societeAdresse          String?
  gestionnaires           InvoiceGestionnaire[]
  devise                  Devise           @default(XOF) // 💰 Nouvelle colonne
  bonCommande             BonCommande?
  factureNormaliser       FactureNormaliser?
}

model BonCommande {
  id        String   @id @default(uuid())
  invoiceId String   @unique
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  url       String
  createdAt DateTime @default(now())
}

model FactureNormaliser {
  id        String   @id @default(uuid())
  invoiceId String   @unique
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  url       String
  createdAt DateTime @default(now())
}

model InvoiceProduit {
  id           String     @id @default(uuid())
  invoiceId    String
  productId    String
  invoice      Invoice    @relation(fields: [invoiceId], references: [id])
  produit      Produit    @relation(fields: [productId], references: [id])
  designation  String
  quantite     Int
  prixUnitaire Decimal
  duree        Decimal
  uniteDuree   UniteDuree
  montantTotal Decimal
  includeduree  Boolean @default(false)
}

model Gestionnaire {
  id        String                @id @default(uuid())
  nom       String
  prenom    String
  email     String                @unique
  telephone String?
  factures  InvoiceGestionnaire[]
}

model InvoiceGestionnaire {
  invoiceId      String
  gestionnaireId String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id])
  gestionnaire   Gestionnaire @relation(fields: [gestionnaireId], references: [id])

  @@id([invoiceId, gestionnaireId])
}