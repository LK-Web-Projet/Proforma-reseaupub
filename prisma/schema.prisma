generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- MODELS ---

enum UniteDuree {
  jour
  heure
  mois
}

model Client {
  id        String    @id @default(uuid())
  nom       String    @unique
  email     String?
  telephone String?
  adresse   String?
  factures  Invoice[]
}

model Produit {
  id           String @id @default(uuid())
  nom          String @unique
  prixUnitaire Decimal
  produitsFacture InvoiceProduit[]
}


model Invoice {
  id                      String           @id @default(uuid())
  numero                  String           @unique
  dateCreation            DateTime         @default(now())
  objet                   String
  clientId                String
  client                  Client           @relation(fields: [clientId], references: [id])
  totalHT                 Decimal
  tva                     Decimal
  totalTTC                Decimal
  statut                  String
  pdfUrl                  String?
  produits                InvoiceProduit[]
  historiqueModifications Json?
  societeNom              String
  societeIFU              String
  societeAdresse          String?
}

model InvoiceProduit {
  id           String     @id @default(uuid())
  invoiceId    String
  productId    String
  invoice      Invoice    @relation(fields: [invoiceId], references: [id])
  produit      Produit    @relation(fields: [productId], references: [id])
  designation  String
  quantite     Int
  prixUnitaire Decimal
  duree        Decimal
  uniteDuree   UniteDuree
  montantTotal Decimal
}
