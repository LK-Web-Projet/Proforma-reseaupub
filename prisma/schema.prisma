generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Role {
  id                       String           @id @default(uuid())
  nom                      String           @unique
  canManageUsers           Boolean          @default(false)
  // Droits du circuit budget — cochés par rôle dans Paramètres > Rôles (aucun nom de rôle codé en dur).
  canValidateBudgetMensuel Boolean          @default(false) // budgets mensuels + budgets au-dessus du plafond délégué
  canValidateBudget        Boolean          @default(false) // budgets hors mensuels, jusqu'au plafond délégué
  canPayBudget             Boolean          @default(false) // enregistrer les dépenses (comptable)
  // Saisie directe au journal de caisse (hors budget) : opérations manuelles, transferts,
  // création de caisses, dépenses imputées à une proforma. Sans ce droit, aucun argent ne sort
  // autrement que par le circuit budget (procédure de paiement, règle d'or n° 2).
  canSaisirCaisse          Boolean          @default(false)
  // Petites dépenses hors bon (accueil) : sur une ligne de budget, en espèces seulement, jusqu'à
  // EntrepriseConfig.plafondPetiteDepense. Ne permet ni de payer un BC ni une facture.
  canSaisirPetiteDepense   Boolean          @default(false)
  createdAt                DateTime         @default(now())
  pages                    RolePage[]
  permissions              RolePermission[]
  users                    User[]
}

// Une ligne par (rôle, section de sidebar) autorisée — la "case cochée" par l'admin.
// Valeurs possibles pour `page` : "dashboard" | "proforma" | "client" | "fournisseurs" | "commercial" | "finance" | "parametres"
model RolePage {
  roleId String
  page   String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, page])
}

// Droits d'action d'un rôle (clés « module.action » du catalogue lib/permissions.ts).
model RolePermission {
  roleId     String
  permission String
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
}

model User {
  id        String   @id // = Clerk userId
  email     String   @unique
  nom       String
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  facturesCreees                   Invoice[]                     @relation("InvoiceCreatedBy")
  paiementsCrees                   Paiement[]                    @relation("PaiementCreatedBy")
  cashJournalEntriesCrees          CashJournal[]                 @relation("CashJournalCreatedBy")
  facturesFournisseurCrees         FactureFournisseur[]          @relation("FactureFournisseurCreatedBy")
  fournisseurStatutHistoriqueCrees FournisseurStatutHistorique[] @relation("FournisseurStatutHistoriqueCreatedBy")
  fournisseurDocumentsCrees        FournisseurDocument[]         @relation("FournisseurDocumentCreatedBy")
  departements                     UtilisateurDepartement[]
}

model EntrepriseConfig {
  id                        String       @id @default("singleton")
  nom                       String       @default("Reseaupub")
  slogan                    String?
  adresse                   String       @default("Etoile Rouge, Cotonou, Bénin")
  telephone                 String       @default("+229 01 69 81 30 30")
  email                     String       @default("contact@reseaupub.com")
  emailFinance              String       @default("finance@reseaupub.com")
  siteWeb                   String?
  ifu                       String       @default("0201710009974")
  rccm                      String?
  nomDirecteur              String       @default("Directeur Général")
  logoPath                  String       @default("rplogo.png")
  // Au-dessus de ce montant, un budget non mensuel doit être validé par un rôle "canValidateBudgetMensuel".
  plafondValidationDeleguee Decimal      @default(500000) @db.Decimal(12, 2)
  // Types de budget dont le scan signé (document BUDGET_SIGNE) est exigé : tant qu’il manque, le
  // budget reste en VALIDATION_PARTIELLE et ses lignes accordées ne sont pas dépensables.
  typesBudgetSigneRequis    TypeBudget[] @default([CAMPAGNE, MENSUEL])
  // Montant maximum d'une petite dépense saisie avec le droit canSaisirPetiteDepense.
  plafondPetiteDepense      Decimal      @default(50000) @db.Decimal(12, 2)
  // Solde d'un bon de commande : exiger la liasse complète (bordereau ou attestation + rapport).
  liasseExigeePourSolde     Boolean      @default(true)
  // Délai de paiement d'une facture prestataire (jours à compter de la date de la facture), selon le
  // type du prestataire ; au-delà, la facture est « en retard » (ligne rouge, notification).
  delaiPaiementFournisseur  Int          @default(30)
  delaiPaiementInterne      Int          @default(7)
  delaiPaiementExterne      Int          @default(3)
  // Délai de relance d'une facture normalisée envoyée au client (jours, proposé à l'ajout de la
  // facture et modifiable pour chacune) : au-delà, le paiement est « à réclamer ».
  delaiRelanceFactureClient Int          @default(30)
  updatedAt                 DateTime     @updatedAt
}

model Client {
  id        String    @id @default(uuid())
  nom       String    @unique
  email     String?
  telephone String?
  adresse   String?
  factures  Invoice[]
}

model Produit {
  id              String           @id @default(uuid())
  nom             String           @unique
  prixUnitaire    Decimal
  actif           Boolean          @default(true)
  produitsFacture InvoiceProduit[]
}

model Invoice {
  id                         String                        @id @default(uuid())
  numero                     String                        @unique
  dateCreation               DateTime                      @default(now())
  dateValidation             DateTime?
  objet                      String
  clientId                   String
  totalHT                    Decimal
  tva                        Decimal
  totalTTC                   Decimal
  historiqueModifications    Json?
  societeNom                 String
  societeIFU                 String
  societeAdresse             String?
  statut                     StatusFacture                 @default(Brouillon)
  devise                     Devise                        @default(XOF)
  paymentConditionPercentage Int?
  resteAPayer                Decimal                       @default(0.00)
  info                       String?
  isTaxExempt                Boolean                       @default(false)
  isDiscountEnabled          Boolean                       @default(false)
  discountType               DiscountType                  @default(POURCENTAGE)
  discountValue              Decimal                       @default(0) @db.Decimal(10, 2)
  discountAmount             Decimal                       @default(0) @db.Decimal(10, 2)
  createdById                String?
  bonCommande                BonCommande?
  factureNormaliser          FactureNormaliser?
  client                     Client                        @relation(fields: [clientId], references: [id])
  createdBy                  User?                         @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  gestionnaires              InvoiceGestionnaire[]
  produits                   InvoiceProduit[]
  paiements                  Paiement[]
  demandesBudget             DemandeBudgetProforma[]
  commandesFournisseur       CommandeFournisseurProforma[]
  budgetDepenses             BudgetDepense[]
  documents                  DocumentProforma[]
  historique                 InvoiceHistorique[]
}

// Anciennes tables des pièces de la proforma (une seule pièce par sorte) : reprises dans
// DocumentProforma par la mise à jour 20261125100000_pieces_historique_proforma. Plus écrites ni
// lues par l'application ; à supprimer par une mise à jour suivante, après vérification en ligne.
model BonCommande {
  id        String   @id @default(uuid())
  invoiceId String   @unique
  url       String
  createdAt DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
}

model FactureNormaliser {
  id        String   @id @default(uuid())
  invoiceId String   @unique
  url       String
  createdAt DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
}

// Sortes de pièces jointes à une proforma (liste extensible).
enum TypeDocumentProforma {
  BON_COMMANDE // bon de commande du client
  FACTURE_NORMALISEE // facture normalisée émise au client (dates d'émission, d'envoi, délai de relance)
  ATTESTATION_BONNE_FIN // attestation de bonne fin d'exécution (clôt le dossier)
  AUTRE
}

// Pièces d'une proforma (remplace BonCommande et FactureNormaliser) : plusieurs pièces de la même
// sorte possibles (ex. facture d'acompte puis de solde). Les fichiers restent rangés par sorte dans
// public/Upload/Bon|Facture|Attestation|Autre/<numéro de proforma>/ ; `url` est l'adresse publique.
model DocumentProforma {
  id                String               @id @default(uuid())
  invoiceId         String
  type              TypeDocumentProforma
  url               String
  fileName          String?
  fileType          String?
  // Précision libre (ex. « Acompte 50 % », « Solde »).
  precision         String?
  // Facture normalisée : numéro, montant facturé, date d'émission, date d'envoi au client et délai
  // de relance (jours). Échéance = date d'envoi + délai ; au-delà, s'il reste à encaisser : « à
  // réclamer » (rouge, notification une seule fois : relanceNotifieeAt).
  numeroFacture     String?
  montant           Decimal?             @db.Decimal(14, 2)
  dateEmission      DateTime?
  dateEnvoiClient   DateTime?
  delaiRelanceJours Int?
  relanceNotifieeAt DateTime?
  ajouteParEmail    String?
  ajouteParNom      String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  invoice           Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, type])
}

// Historique d'une proforma : toutes les actions la concernant (création, modifications, statuts,
// encaissements, dépenses, pièces, e-mails…), avec leur auteur. Codes et libellés des actions :
// lib/proformaHistorique.ts.
model InvoiceHistorique {
  id          String   @id @default(uuid())
  invoiceId   String
  action      String
  details     String?
  donnees     Json?
  auteurEmail String?
  auteurNom   String?
  createdAt   DateTime @default(now())
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, createdAt])
}

model InvoiceProduit {
  id           String     @id @default(uuid())
  invoiceId    String
  productId    String
  designation  String
  quantite     Int
  prixUnitaire Decimal
  duree        Decimal
  uniteDuree   UniteDuree
  montantTotal Decimal
  includeduree Boolean    @default(false)
  invoice      Invoice    @relation(fields: [invoiceId], references: [id])
  produit      Produit    @relation(fields: [productId], references: [id])
}

model Gestionnaire {
  id        String                @id @default(uuid())
  nom       String
  prenom    String
  email     String                @unique
  telephone String?
  // Inactif : n'est plus proposé sur les nouvelles proformas, reste affiché sur les anciennes.
  actif     Boolean               @default(true)
  factures  InvoiceGestionnaire[]
}

model InvoiceGestionnaire {
  invoiceId      String
  gestionnaireId String
  gestionnaire   Gestionnaire @relation(fields: [gestionnaireId], references: [id])
  invoice        Invoice      @relation(fields: [invoiceId], references: [id])

  @@id([invoiceId, gestionnaireId])
}

model Paiement {
  id                 String       @id @default(uuid())
  montant            Decimal
  datePaiement       DateTime     @default(now())
  methode            String?
  reference          String?
  notes              String?
  invoiceId          String
  cashJournalEntryId Int?         @unique
  type               PaiementType @default(PAIEMENT)
  createdById        String?
  cashJournalEntry   CashJournal? @relation(fields: [cashJournalEntryId], references: [id])
  invoice            Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy          User?        @relation("PaiementCreatedBy", fields: [createdById], references: [id])
  // Dépense reçue de Camptrack (ancien appel, sans ligne de budget) sur une proforma qui a un
  // budget : à rattacher à une ligne de budget par le comptable (crée alors la BudgetDepense).
  aRattacherBudget   Boolean      @default(false)

  @@map("paiements")
}

model CashRegister {
  id             Int                   @id @default(autoincrement())
  name           String                @unique
  balance        Float                 @default(0)
  createdAt      DateTime              @default(now())
  view           Boolean               @default(true)
  journals       CashJournal[]
  budgetDepenses BudgetDepense[]
  moyensPaiement MoyenPaiementCaisse[]
}

model CashJournal {
  id                   Int                     @id @default(autoincrement())
  date_operation       DateTime
  libelle              String
  type                 OperationType
  montant              Float
  solde                Float
  createdAt            DateTime                @default(now())
  cashRegisterId       Int                     @default(1)
  isApportDeCaisse     Boolean?                @default(false)
  createdById          String?
  cashRegister         CashRegister            @relation(fields: [cashRegisterId], references: [id])
  createdBy            User?                   @relation("CashJournalCreatedBy", fields: [createdById], references: [id])
  attachments          CashJournalAttachment[]
  facturePayee         FactureFournisseur?     @relation("FacturePaiementCaisse")
  paiement             Paiement?
  budgetDepense        BudgetDepense?          @relation("BudgetDepenseEcriture")
  // Renseigné si cette écriture (RECETTE) est la contre-écriture d'une dépense de budget annulée.
  budgetDepenseAnnulee BudgetDepense?          @relation("BudgetDepenseContreEcriture")
  imputationsCommande  ImputationCommande[]
  lotPaiement          LotPaiement?
}

model CashJournalAttachment {
  id            String      @id @default(uuid())
  cashJournalId Int
  url           String
  fileName      String
  fileType      String
  createdAt     DateTime    @default(now())
  cashJournal   CashJournal @relation(fields: [cashJournalId], references: [id], onDelete: Cascade)
}

model Fournisseur {
  id                    String                             @id @default(cuid())
  nom                   String?
  prenom                String?
  entreprise            String                             @unique
  contact               String
  domaineActivite       String
  adresse               String
  email                 String?                            @unique
  typeFournisseur       String?
  actif                 Boolean                            @default(true)
  dateDebutContrat      DateTime?
  dateFinContrat        DateTime?
  createdAt             DateTime                           @default(now())
  updatedAt             DateTime                           @updatedAt
  commandes             CommandeFournisseur[]
  factures              FactureFournisseur[]
  produits              ProduitFournisseur[]
  statutHistorique      FournisseurStatutHistorique[]
  documents             FournisseurDocument[]
  // Département de rattachement (prestataires internes et certains externes ; jamais un « Fournisseur »)
  // et poste occupé (lib/departements.ts : RESPONSABLE, EQUIPE, STAGIAIRE_PRO…). Chaque changement
  // est tracé dans FournisseurDepartementHistorique.
  departementId         String?
  departement           Departement?                       @relation(fields: [departementId], references: [id])
  posteDepartement      String?
  departementHistorique FournisseurDepartementHistorique[]

  @@index([departementId])
}

// Départements (services) de l'entreprise : chaque ligne de budget est rattachée à un département,
// ce qui permet de suivre les dépenses par département et par mois. Le nom est toujours en
// majuscules (normalisé par le serveur). Un département utilisé ne se supprime pas : on le désactive.
model Departement {
  id                 String   @id @default(uuid())
  nom                String   @unique
  code               String?  @unique // code court : INFO, RH, DG…
  description        String?
  emailContact       String?
  telephone          String?
  codeAnalytique     String? // centre de coût utilisé en comptabilité
  couleur            String? // couleur des graphiques (#RRGGBB)
  enveloppeMensuelle Decimal? @db.Decimal(12, 2) // montant mensuel indicatif, pour comparer au dépensé
  actif              Boolean  @default(true)
  createdByEmail     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  lignesBudget   DemandeBudgetLigne[]
  budgetsInvites DemandeBudgetDepartement[]
  utilisateurs   UtilisateurDepartement[]
  prestataires   Fournisseur[]
  arrivees       FournisseurDepartementHistorique[] @relation("HistoriqueNouveauDepartement")
  departs        FournisseurDepartementHistorique[] @relation("HistoriqueAncienDepartement")
}

// Historique des rattachements d'un prestataire : changement de département et/ou de poste.
model FournisseurDepartementHistorique {
  id                   String       @id @default(uuid())
  fournisseurId        String
  ancienDepartementId  String?
  nouveauDepartementId String?
  ancienPoste          String?
  nouveauPoste         String?
  dateEffet            DateTime
  motif                String?
  auteurEmail          String?
  auteurNom            String?
  createdAt            DateTime     @default(now())
  fournisseur          Fournisseur  @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)
  ancienDepartement    Departement? @relation("HistoriqueAncienDepartement", fields: [ancienDepartementId], references: [id])
  nouveauDepartement   Departement? @relation("HistoriqueNouveauDepartement", fields: [nouveauDepartementId], references: [id])

  @@index([fournisseurId, dateEffet])
}

model FournisseurStatutHistorique {
  id            String      @id @default(uuid())
  fournisseurId String
  actif         Boolean
  motif         String?
  dateContrat   DateTime?
  createdAt     DateTime    @default(now())
  createdById   String?
  fournisseur   Fournisseur @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)
  createdBy     User?       @relation("FournisseurStatutHistoriqueCreatedBy", fields: [createdById], references: [id])
}

model FournisseurDocument {
  id            String      @id @default(uuid())
  fournisseurId String
  type          String
  url           String
  fileName      String
  fileType      String
  createdAt     DateTime    @default(now())
  createdById   String?
  fournisseur   Fournisseur @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)
  createdBy     User?       @relation("FournisseurDocumentCreatedBy", fields: [createdById], references: [id])
}

model FactureFournisseur {
  id                      String                               @id @default(cuid())
  reference               String                               @unique
  montant                 Decimal                              @db.Decimal(10, 2)
  date                    DateTime
  pieceJointe             String?
  status                  StatutFactureFournisseur             @default(EN_ATTENTE)
  createdAt               DateTime                             @default(now())
  updatedAt               DateTime                             @updatedAt
  fournisseurId           String
  createdById             String?
  fournisseur             Fournisseur                          @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)
  createdBy               User?                                @relation("FactureFournisseurCreatedBy", fields: [createdById], references: [id])
  // Bon de commande réglé par cette facture (Lot C) ; la facture passe PAYEE quand une dépense de
  // budget de nature SOLDE la règle — jamais à la main.
  commandeId              String?
  commande                CommandeFournisseur?                 @relation(fields: [commandeId], references: [id])
  depenses                BudgetDepense[]
  // Prestataire interne / externe (pas de bon de commande obligatoire) : la facture peut être
  // rattachée directement à une ligne de budget (ex. budget mensuel de la comptabilité pour la paie)
  // et réglée par des dépenses sur cette ligne ; elle passe PAYEE quand elle est entièrement réglée.
  ligneBudgetId           String?
  ligneBudget             DemandeBudgetLigne?                  @relation(fields: [ligneBudgetId], references: [id])
  // Retard de paiement déjà notifié (une seule fois par facture ; remis à zéro si la date change).
  retardNotifieAt         DateTime?
  // Paiement fait hors plateforme (facture liée à aucun bon ni ligne de budget, marquée « payée » à la
  // main, sans sortie de caisse) : moyen de paiement, date, preuve (obligatoires) et référence.
  // Remis à vide quand la facture quitte le statut « payée ».
  paiementManuelDate      DateTime?
  paiementManuelMode      String?
  paiementManuelMoyen     MoyenPaiement?                       @relation("FacturePaiementManuel", fields: [paiementManuelMode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  paiementManuelPreuve    String?
  paiementManuelReference String?
  paiementManuelParEmail  String?
  historiqueStatut        FactureFournisseurStatutHistorique[]
  // Facture réglée par « Appliquer le paiement » SANS dépense de budget (aucune ligne de budget : caisse
  // seule, ou campagne sans budget) : l'écriture de caisse qui l'a payée. Protège son statut.
  paiementCaisseId        Int?                                 @unique
  paiementCaisse          CashJournal?                         @relation("FacturePaiementCaisse", fields: [paiementCaisseId], references: [id])
}

// Changements de statut faits à la main sur une facture de prestataire (marquée payée hors
// plateforme, annulée, remise en attente, réactivée…), avec leur auteur. Les changements automatiques
// (paiement appliqué depuis le budget) n'y figurent pas : ils ont leur propre trace (dépenses).
model FactureFournisseurStatutHistorique {
  id                   String                   @id @default(uuid())
  factureFournisseurId String
  ancienStatut         StatutFactureFournisseur
  nouveauStatut        StatutFactureFournisseur
  // Paiement hors plateforme (nouveau statut « payée ») : moyen, date, preuve et référence.
  modePaiement         String?
  moyenPaiement        MoyenPaiement?           @relation(fields: [modePaiement], references: [code], onDelete: Restrict, onUpdate: Cascade)
  datePaiement         DateTime?
  preuve               String?
  reference            String?
  motif                String?
  auteurEmail          String
  auteurNom            String?
  createdAt            DateTime                 @default(now())
  factureFournisseur   FactureFournisseur       @relation(fields: [factureFournisseurId], references: [id], onDelete: Cascade)

  @@index([factureFournisseurId])
}

model ProduitFournisseur {
  id             String                     @id @default(uuid())
  designation    String
  description    String?
  prixUnitaire   Decimal                    @db.Decimal(10, 2)
  typeUnite      TypeUnite
  fournisseurId  String
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  lignesCommande LigneCommandeFournisseur[]
  fournisseur    Fournisseur                @relation(fields: [fournisseurId], references: [id])
  photos         ProduitFournisseurPhoto[]
}

model ProduitFournisseurPhoto {
  id                   String             @id @default(uuid())
  produitFournisseurId String
  url                  String
  fileName             String
  fileType             String
  createdAt            DateTime           @default(now())
  produitFournisseur   ProduitFournisseur @relation(fields: [produitFournisseurId], references: [id], onDelete: Cascade)
}

model CommandeFournisseur {
  id             String                        @id @default(uuid())
  numero         String                        @unique
  dateCommande   DateTime                      @default(now())
  statut         StatutCommandeFournisseur     @default(BROUILLON)
  fournisseurId  String
  totalHT        Decimal                       @db.Decimal(10, 2)
  appliquerTva   Boolean                       @default(false)
  tva            Decimal                       @default(0) @db.Decimal(10, 2)
  appliquerAib   Boolean                       @default(false)
  montantAib     Decimal                       @default(0) @db.Decimal(10, 2)
  totalTTC       Decimal                       @default(0) @db.Decimal(10, 2)
  montantNet     Decimal                       @default(0) @db.Decimal(10, 2)
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt
  fournisseur    Fournisseur                   @relation(fields: [fournisseurId], references: [id])
  lignes         LigneCommandeFournisseur[]
  demandesBudget DemandeBudget[]
  proformas      CommandeFournisseurProforma[]
  // Ligne de budget qui finance ce bon de commande (procédure, section 4 : « les bons de commande
  // sont émis à partir du budget »). Les avances et le solde sont des dépenses de cette ligne.
  ligneBudgetId  String?
  ligneBudget    DemandeBudgetLigne?           @relation(fields: [ligneBudgetId], references: [id])
  documents      CommandeFournisseurDocument[]
  factures       FactureFournisseur[]
  depenses       BudgetDepense[]
  imputations    ImputationCommande[]
}

// Pièces de la « liasse » d'un bon de commande (procédure, section 4) : BC signé par la DG,
// proforma fournisseur, BAT signé (facultatif), bordereau de livraison signé ou attestation de
// service fait, facture, autres documents (libellé précisé).
model CommandeFournisseurDocument {
  id             String               @id @default(uuid())
  commandeId     String
  kind           TypeDocumentCommande
  url            String
  fileName       String
  fileType       String
  // Précision du document (obligatoire pour « Autre ») ou origine (proforma reprise du budget).
  libelle        String?
  createdByEmail String
  createdAt      DateTime             @default(now())
  commande       CommandeFournisseur  @relation(fields: [commandeId], references: [id], onDelete: Cascade)
}

enum TypeDocumentCommande {
  BC_SIGNE
